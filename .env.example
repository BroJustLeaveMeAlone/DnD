# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Database ---
# Matches the docker-compose.yml service defaults.
# If 5432 is already taken (another Postgres, another project's container),
# change POSTGRES_PORT and the port in DATABASE_URL together — compose reads
# POSTGRES_PORT for the host-side binding.
POSTGRES_USER=ttrpg
POSTGRES_PASSWORD=ttrpg_dev_password
POSTGRES_DB=ttrpg
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ttrpg:ttrpg_dev_password@localhost:5432/ttrpg

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- OAuth providers (optional in dev; email/password works without them) ---
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
